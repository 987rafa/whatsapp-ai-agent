# ── AI provider ────────────────────────────────────────────────
# gemini = Google Gemini (has a free tier)  |  openai = any OpenAI-compatible API
AI_PROVIDER=gemini

# Google Gemini  →  get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI-compatible: OpenAI, Groq, OpenRouter, Together, Ollama, LM Studio…
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Agent behaviour ────────────────────────────────────────────
BOT_NAME=Aria
BOT_LANG=es
AI_SYSTEM_PROMPT=You are a helpful, friendly assistant inside WhatsApp. Keep answers concise and natural.
AI_PRIVATE_CHATS=true
AI_GROUP_MENTIONS=true
AI_HISTORY_SIZE=12
AI_MAX_TOKENS=1024

# ── Modo secretario (auto-respuesta autónoma en privados) ──────
# assistant = responde como tu asistente personal | owner = responde en tu nombre
AUTO_REPLY_MODE=assistant
OWNER_NAME=Rafael
# Estilo con el que debe escribir
OWNER_STYLE=Responde cercano, breve y natural; nada de sonar robótico.
# Solo estos números podrán recibir auto-respuesta (vacío = todos). Separa con comas.
AUTO_REPLY_ALLOW=
# Nunca responder a estos números (tiene prioridad). Separa con comas.
AUTO_REPLY_DENY=
# Número que recibe un aviso cuando algo necesita a una persona real (vacío = sin avisos)
OWNER_NOTIFY=
# Cada cuántos mensajes la IA actualiza su resumen y aprende datos del contacto
MEMORY_SUMMARY_EVERY=16

# Command prefix (e.g. "!" → !help)
BOT_PREFIX=!

# ── Connection ─────────────────────────────────────────────────
# Optional: link with an 8-digit pairing code instead of QR (international format, no "+")
# e.g. for +57 300 123 4567 write: 573001234567
PAIRING_PHONE=

# ── Pedidos a NOVUS POS (opcional) ─────────────────────────────
# Toma pedidos por WhatsApp (!pedido 2 gaseosa, 1 pan tajado) y los manda al
# panel de Pedidos de NOVUS POS, donde caja los confirma o los rechaza.
# POS_URL = dirección de la API del POS · POS_API_KEY = su ORDERS_API_KEY.
POS_URL=
POS_API_KEY=

# ── Misc ───────────────────────────────────────────────────────
LOG_LEVEL=info
DATA_DIR=./data
