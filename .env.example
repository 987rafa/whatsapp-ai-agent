# ── AI provider ────────────────────────────────────────────────
# gemini = Google Gemini (has a free tier)  |  openai = any OpenAI-compatible API
AI_PROVIDER=gemini

# Google Gemini  →  get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI-compatible: OpenAI, Groq, OpenRouter, Together, Ollama, LM Studio…
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ── Agent behaviour ────────────────────────────────────────────
BOT_NAME=Aria
BOT_LANG=es
AI_SYSTEM_PROMPT=You are a helpful, friendly assistant inside WhatsApp. Keep answers concise and natural.
AI_PRIVATE_CHATS=true
AI_GROUP_MENTIONS=true
AI_HISTORY_SIZE=12
AI_MAX_TOKENS=1024

# Command prefix (e.g. "!" → !help)
BOT_PREFIX=!

# ── Connection ─────────────────────────────────────────────────
# Optional: link with an 8-digit pairing code instead of QR (international format, no "+")
# e.g. for +57 300 123 4567 write: 573001234567
PAIRING_PHONE=

# ── Misc ───────────────────────────────────────────────────────
LOG_LEVEL=info
DATA_DIR=./data
